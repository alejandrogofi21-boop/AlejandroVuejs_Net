{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "pokemon-route": {
        "ClusterId": "consultas-cluster",
        "Match": {
          "Path": "/api/pokemon/{**catch-all}"
        }
      },
      "tipos-route": {
        "ClusterId": "catalogos-cluster",
        "Match": {
          "Path": "/api/tipos/{**catch-all}"
        }
      },
      "movimientos-route": {
        "ClusterId": "catalogos-cluster",
        "Match": {
          "Path": "/api/movimientos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "consultas-cluster": {
        "Destinations": {
          "destino1": {
            "Address": "http://localhost:5172/"
          }
        }
      },
      "catalogos-cluster": {
        "Destinations": {
          "destino1": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}